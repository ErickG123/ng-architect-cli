{
  "name": "@erickg123/ng-architect-cli",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "create-ng-arch": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickg123/ng-architect-cli.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "npm run build && node ./dist/index.js",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "commit-and-tag-version": "^12.5.0",
    "husky": "^9.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
